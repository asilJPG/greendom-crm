# Эти значения задаются в настройках проекта Vercel (Settings → Environment Variables).
# Настоящие значения в файлы не записывайте и никому не показывайте. Подробности — в README.md.

# Строка подключения к базе Postgres (Neon).
DATABASE_URL=

# Длинная случайная строка (не короче 16 символов, лучше 32+): подпись сессий и шифрование сохранённых паролей.
SESSION_SECRET=

# Секретный ключ, который моноблок присылает в /api/ingest (не короче 16 символов, лучше 32+).
INGEST_TOKEN=

# Одноразовый ключ первичной настройки (POST /api/setup создаёт первого администратора, пока пользователей нет).
SETUP_KEY=

# Необязательно: уведомления в Telegram (несколько чатов — через запятую; тема форума — TG_THREAD_ID).
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_THREAD_ID=

# Часовой пояс для «сегодня» в отчётах (по умолчанию Asia/Tashkent).
TZ_NAME=Asia/Tashkent
