# Эти значения задаются в настройках проекта Vercel (Settings → Environment Variables).
# Настоящие значения в файлы не записывайте и никому не показывайте.

# Строка подключения к базе Postgres (Neon). Подставится сама, если подключить Neon через Vercel Marketplace.
DATABASE_URL=

# Секретный ключ, который моноблок присылает при отправке данных. Не короче 32 символов.
INGEST_TOKEN=

# Пароли для входа на сайт, через запятую (запятых внутри паролей не должно быть). Не короче 10 символов.
DASHBOARD_PASSWORDS=

# Любая длинная случайная строка (не короче 32 символов) для подписи входа на сайт.
SESSION_SECRET=

# Часовой пояс для «сегодня» в отчётах (по умолчанию Asia/Tashkent).
TZ_NAME=Asia/Tashkent
